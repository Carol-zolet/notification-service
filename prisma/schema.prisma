generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Colaborador {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  unidade   String
  createdAt DateTime @default(now())
}

model Notification {
  id           String    @id @default(uuid())
  email        String
  subject      String
  message      String
  scheduledFor DateTime
  status       String    @default("pending")
  sentAt       DateTime?
  retryCount   Int       @default(0)
  createdAt    DateTime  @default(now())
}

model SendHistory {
  id            String   @id @default(uuid())
  unidade       String
  subject       String
  total         Int
  dryRun        Boolean  @default(false)
  testRecipient String?
  createdAt     DateTime @default(now())
}

model LoginCode {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// Mutex puro: só existe uma linha aqui enquanto um envio está de fato em andamento
// pra essa unidade+período. É apagada assim que termina (sucesso ou erro) — quem
// controla "já enviei pra essa pessoa nesse período" é o PayslipReceipt, não isso.
model BatchLock {
  id         String   @id @default(uuid())
  unidade    String
  periodo    String   // ano-mês de referência, ex: "2026-08"
  status     String
  iniciadoEm DateTime @default(now())

  @@unique([unidade, periodo])
}

// Um recibo por colaborador+período. Existência = "já recebeu o holerite desse mês".
// Um novo disparo pra mesma unidade+período pula quem já tem recibo (a menos que
// force=true), em vez de bloquear o lote inteiro — permite completar envios parciais
// (ex: 3 pessoas que deram erro) sem duplicar quem já recebeu certo.
model PayslipReceipt {
  id            String   @id @default(uuid())
  unidade       String
  periodo       String
  colaboradorId String
  enviadoEm     DateTime @default(now())

  @@unique([unidade, periodo, colaboradorId])
}

// Fila de reenvio automático — só entra aqui quem falhou especificamente por
// rate limit da Brevo (nunca por erro definitivo tipo email inválido, isso
// continua caindo como falha normal). Um cron diário tenta reenviar; depois
// de LIMITE_TENTATIVAS (hoje 5) sem sucesso, sai da fila e vira alerta manual.
// Guarda o PDF individual já cortado pra não precisar re-rodar o splitter
// no reenvio, mesmo que o arquivo original não esteja mais disponível.
model PayslipPending {
  id              String    @id @default(uuid())
  unidade         String
  periodo         String
  colaboradorId   String
  motivo          String    // 'rate_limit' — único motivo que entra na fila hoje
  tentativas      Int       @default(1)
  criadoEm        DateTime  @default(now())
  ultimaTentativa DateTime?
  pdfBuffer       Bytes

  @@unique([unidade, periodo, colaboradorId])
}
